# Required before deployment. For local development, generate a long random value.
SECRET_KEY=change-this-before-sharing

# Leave blank to use instance/caudex.db (SQLite). For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://caudex:caudex@localhost:5432/caudex
DATABASE_URL=

HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Local prototype compiler. This is NOT a security sandbox.
# Set to disabled when you do not need compilation.
CAUDEX_RUNNER_BACKEND=local
CXX=g++

# Optional. Useful after deployment so copied room links use your public domain.
# PUBLIC_BASE_URL=https://caudex.example.com
PUBLIC_BASE_URL=
