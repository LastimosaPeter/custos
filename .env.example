SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ALLOWED_EMAIL_DOMAIN=adnu.edu.ph
APP_TIMEZONE=Asia/Manila
SESSION_COOKIE_SECURE=0

# Local development: leave DATABASE_URL blank to use SQLite.
DATABASE_URL=
EXAM_DB_PATH=exam.db

# Custos Programming IDE
# Student access remains behind a feature flag until the IDE is ready for release.
STUDENT_IDE_ENABLED=0
# Production recommendation: judge0. Leave disabled until a runner is configured.
CODE_RUNNER_BACKEND=disabled
# JUDGE0_URL=https://your-isolated-judge0.example.com
# JUDGE0_TOKEN=
# JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_CPP_LANGUAGE_ID=54

# Development-only local runner. Do not enable on an internet-facing Flask server.
CODE_RUNNER_ALLOW_LOCAL=0
CXX=g++
CODE_RUNNER_CPU_SECONDS=2
CODE_RUNNER_WALL_SECONDS=5
CODE_RUNNER_COMPILE_SECONDS=8
CODE_RUNNER_MEMORY_KB=131072
CODE_RUNNER_MAX_SOURCE=50000
CODE_RUNNER_MAX_STDIN=10000

# Application identity
APP_NAME=Custos
APP_VERSION=1.0
APP_RELEASE_SPECIES=Goliathus
APP_RELEASE_COMMON_NAME=Goliathus release
APP_ASSET_REVISION=1.0-goliathus-r1
