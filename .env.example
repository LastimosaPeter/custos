SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ALLOWED_EMAIL_DOMAIN=adnu.edu.ph
APP_TIMEZONE=Asia/Manila
SESSION_COOKIE_SECURE=0

# Local development: leave DATABASE_URL blank to use SQLite.
DATABASE_URL=
EXAM_DB_PATH=exam.db

# Portable server/runtime settings
HOST=0.0.0.0
PORT=5000
WAITRESS_THREADS=8
AUTO_INIT_DB=1
FORCE_DB_INIT=0

# PostgreSQL connection reuse. Disable only if your database provider requires
# one fresh connection per request. These values are per app process.
DB_POOL_ENABLED=1
DB_POOL_MIN=1
DB_POOL_MAX=8

# Custos Programming IDE
# Student access remains behind a feature flag until the IDE is ready for release.
STUDENT_IDE_ENABLED=0
# Production recommendation: judge0. Leave disabled until a runner is configured.
CODE_RUNNER_BACKEND=disabled
# JUDGE0_URL=https://your-isolated-judge0.example.com
# JUDGE0_TOKEN=
# JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_CPP_LANGUAGE_ID=54

# Development-only local runner. Do not enable on an internet-facing Flask server.
CODE_RUNNER_ALLOW_LOCAL=0
CXX=g++
CODE_RUNNER_CPU_SECONDS=2
CODE_RUNNER_WALL_SECONDS=5
CODE_RUNNER_COMPILE_SECONDS=8
CODE_RUNNER_MEMORY_KB=131072
CODE_RUNNER_MAX_SOURCE=50000
CODE_RUNNER_MAX_STDIN=10000

# Application identity
APP_NAME=Custos
APP_VERSION=1.6.0.h
APP_RELEASE_SPECIES=Hercules
APP_RELEASE_COMMON_NAME=Hercules beetle release
APP_RELEASE_SCIENTIFIC_NAME=Dynastes hercules
APP_ASSET_REVISION=1.6.0-h-hercules-workbench-r24

# Google sign-in + Google Classroom roster import (see google_integration.py).
# Leave GOOGLE_CLIENT_ID blank to keep the classic typed student form.
# Create an OAuth 2.0 "Web application" client and add your site origin under
# "Authorized JavaScript origins" (no redirect URI needed - popup flow).
GOOGLE_CLIENT_ID=
# Student Google accounts must belong to one of these Workspace domains.
GOOGLE_ALLOWED_DOMAINS=adnu.edu.ph,gbox.adnu.edu.ph
# 1 = students must sign in with Google (typed email disabled). Default 1 when a client id is set.
STUDENT_GOOGLE_LOGIN_REQUIRED=1

# Classroom-based instructors (requires GOOGLE_CLIENT_ID). Instructors are the
# Teachers of active Google Classroom courses (checked at every sign-in); each
# course becomes a subject and instructors see only their own courses. The
# password login becomes an owner-only emergency path (/admin/login?password=1).
CLASSROOM_INSTRUCTORS=0
# Owners: see everything and skip the Classroom teacher check.
CUSTOS_OWNER_EMAILS=
# School domains that are the same person ("alias=canonical", comma-separated).
EMAIL_DOMAIN_ALIASES=gbox.adnu.edu.ph=adnu.edu.ph

# Optional local-only private bank path for the CSEC303 PHANTOM-303 midterm.
# The default is private_banks/csec303_midterm/question_bank.json (Git-ignored).
# CSEC303_PRIVATE_BANK_PATH=
